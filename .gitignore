# System
.DS_Store

# Agent config
.claude/settings.local.json

# Secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
# App Store Connect API keys, which notarytool takes as --key. Downloadable once
# and never again, so the copy on disk is the only copy.
*.p8
credentials.json
token.json

# Release artifacts, signed and notarized locally (ADR 0014)
dist/

# Zig
.zig-cache/
zig-out/
zig-pkg/
*.o
*.d
*.pdb

# CMake (clap-wrapper builds)
build/

# Host verification captures
#
# `verification/` is where a `screencapture` of the editor goes before
# `scripts/measure-trace` reads it. They are working artifacts of one session:
# frequent, a couple of megabytes each, and superseded by the next build. The
# numbers measured out of them belong in the issue or the plan; the pixels do
# not belong in a public repository's history.
#
# The directory is tracked through its `.gitkeep` so the path always exists and
# nobody has to remember to create it. One capture reached a commit before this
# rule existed, and removing it meant rewriting three commits.
verification/*
!verification/.gitkeep
