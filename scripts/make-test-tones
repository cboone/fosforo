#!/usr/bin/env bash
# make-test-tones — render the signals the trace's host verification needs, and prove each one holds what it claims
# Author: Christopher Boone
# Date: 2026-08-24
#
# The verification in docs/plans/ for issue #38 prescribes exact frequencies and
# exact levels, and a tone knob in a DAW cannot hit either. REAPER's stock Tone
# Generator is fine for frequency and wrong for level: its "dB" is `2 ^ (x / 6)`,
# so six of its decibels are a factor of two rather than 6.0206 dB, it moves in
# whole-decibel steps, and it stops at +6. `JS: Volume Adjustment` shares the
# same approximation. Rendering the levels instead makes them exact and makes
# them checkable.
#
# Three things about the output are decisions rather than defaults:
#
# **32-bit float, not 24-bit integer.** Three of the level cases sit above 1.0,
# because the trace's rail is at 1.0889 and the point of those files is to cross
# it. No integer format can store them at all.
#
# **The pan is baked into two files rather than left to a knob.** REAPER applies
# track pan *after* the FX chain, so panning the track never reaches the plugin
# and the channel check would silently pass against a plugin that ignored the
# channel entirely. The tap is output channel 0, so pan-hard-right must draw a
# flat trace.
#
# **The levels are not round numbers.** 1.050 is the last level that does not
# rail and 1.089 is the first that does, which is `trace_rail / trace_full_scale`
# from src/gpu/iface.zig. Railing at 1.089 removes a tenth of a backing pixel of
# travel, so it is invisible: what it shows is the peak ceasing to climb, and
# these two files either side of the threshold are what makes that observable.
#
# Every file is read back after it is written and its peak compared against what
# was asked for. A generator that silently clipped its own output would otherwise
# produce a level sweep that tested nothing, which is the same class of failure
# as an install that was never confirmed.
#
# Usage:
#   make-test-tones [OUTDIR]
#
#   OUTDIR   Where to write. Defaults to ~/Music/fosforo-test-tones.
#
# Exit codes:
#   0  - Every file was written and its peak verified
#  64  - Invalid arguments
#  69  - ffmpeg is not installed
#  70  - A file was written whose peak is not what was asked for

set -euo pipefail

readonly E_USAGE=64
readonly E_UNAVAILABLE=69
readonly E_SOFTWARE=70

readonly RATE=48000
readonly DURATION=20
readonly SWEEP_HZ=100

# Peaks are compared to four decimal places. The generator is deterministic, so
# this is checking that ffmpeg wrote what it was told rather than absorbing
# jitter that does not exist.
readonly TOLERANCE=0.0005

function warn() {
  printf 'make-test-tones: %s\n' "${1}" >&2
}

function die() {
  warn "${2}"
  exit "${1}"
}

# A stereo file from an expression per channel. The comma inside mod() has to be
# escaped or ffmpeg reads it as an option separator and rejects the filterchain.
function render() {
  local name="${1}"
  local left="${2}"
  local right="${3}"

  ffmpeg -y -loglevel error \
    -f lavfi -i "aevalsrc=${left}|${right}:s=${RATE}:d=${DURATION}:c=stereo" \
    -c:a pcm_f32le "${OUTDIR}/${name}.wav"
}

# The peaks ffmpeg reads back out of a finished file, as linear amplitudes: one
# line per channel and then one for the file overall.
#
# Taking the first line rather than the loudest is a mistake this script made
# once and caught on itself: a hard-panned file's first channel is silent, so
# `pan-hard-right` reported a peak of zero and looked like a generator failure.
function peaks_of() {
  ffmpeg -v info -i "${1}" -af astats -f null - 2>&1 |
    grep 'Max level:' |
    sed 's/.*Max level: //'
}

function close_enough() {
  awk -v got="${1}" -v want="${2}" -v tol="${TOLERANCE}" \
    'BEGIN { exit ((got - want) ^ 2 <= tol ^ 2) ? 0 : 1 }'
}

# The loudest channel is what the peak means for a file meant to be identical on
# both, and for a panned one it is the channel carrying the tone.
function verify() {
  local name="${1}"
  local want="${2}"
  local got

  got="$(peaks_of "${OUTDIR}/${name}.wav" | sort -rn | head -1)"

  close_enough "${got}" "${want}" ||
    die "${E_SOFTWARE}" "${name}.wav peaks at ${got}, asked for ${want}"

  printf '  %-22s peak %s\n' "${name}.wav" "${got}"
}

# A panned file's whole point is the channel that holds nothing, so that is the
# half worth asserting: `left` or `right` must read exactly zero.
function verify_silent() {
  local name="${1}"
  local side="${2}"
  local line
  local got

  [[ "${side}" == "left" ]] && line=1 || line=2
  got="$(peaks_of "${OUTDIR}/${name}.wav" | sed -n "${line}p")"

  close_enough "${got}" 0 ||
    die "${E_SOFTWARE}" "${name}.wav has ${got} in its ${side} channel, expected silence"

  printf '  %-22s %s channel silent\n' "${name}.wav" "${side}"
}

# Period counting. At 48 kHz the window is 960 samples, so each of these shows
# `f * 0.020` periods: 1, 2, 4, 5, 8 and 20.
function make_sines() {
  local hz

  for hz in 50 100 200 250 400 1000; do
    render "sine-${hz}hz-0.5" "0.5*sin(2*PI*${hz}*t)" "0.5*sin(2*PI*${hz}*t)"
    verify "sine-${hz}hz-0.5" 0.5
  done
}

# The level sweep, all at one frequency so only the vertical axis varies. 0.002
# is the floor: below roughly -54 dBFS a sine moves the trace less than one
# backing pixel at the default editor and reads as flat.
function make_levels() {
  local level

  for level in 0.002 0.010 0.100 0.500 1.000 1.050 1.089 2.000; do
    render "level-${level}" "${level}*sin(2*PI*${SWEEP_HZ}*t)" "${level}*sin(2*PI*${SWEEP_HZ}*t)"
    verify "level-${level}" "${level}"
  done
}

# The tap is output channel 0. Hard right must draw flat, hard left must draw
# full, and anyone who skips this and tests with a hard-right-panned tone will
# file a bug against a working plugin.
function make_pans() {
  local tone="0.5*sin(2*PI*${SWEEP_HZ}*t)"

  render "pan-hard-left" "${tone}" "0"
  verify "pan-hard-left" 0.5
  verify_silent "pan-hard-left" right

  render "pan-hard-right" "0" "${tone}"
  verify "pan-hard-right" 0.5
  verify_silent "pan-hard-right" left
}

# A saw crosses the rail on a linear ramp rather than at a turning point, so it
# shows a small overshoot as a flat top with a vertical edge. A clipped sine's
# plateau can be mistaken for a rounded peak at low zoom; this cannot.
function make_saws() {
  local level
  local ramp

  for level in 0.900 1.100; do
    ramp="${level}*(2*mod(${SWEEP_HZ}*t\\,1)-1)"
    render "saw-${level}" "${ramp}" "${ramp}"
    verify "saw-${level}" "${level}"
  done
}

# Transients, which is the only way persistence can be seen at all.
#
# The accumulation resolves a *stationary* trace to exactly the colour the
# unaccumulated line strip drew, deliberately, so steady material looks identical
# with the phosphor and without it. What differs is what happens after the signal
# changes, and these two files are what make that difference countable rather
# than a matter of opinion.
#
# **A click, not an impulse.** One sample is one column at the default geometry
# and vanishes into the rasterizer; 1 ms at 48 kHz is 48 samples, which is about
# 96 backing pixels on a 2x display and unmissable. Repeating at 2 Hz is what
# turns the persistence into a count: without it exactly one click is ever lit,
# and with it the number visible at once reads tau directly in half-seconds.
#
# The gated sine gives a rise and a decay in one file, which is the shape to
# watch when judging whether the fade looks like a phosphor or like a fade.
#
# `lt()`, `gt()` and `mod()` are ffmpeg's own; the commas inside them need the
# same escaping the saws already do, for the same reason.
function make_transients() {
  local click_window="lt(mod(t\\,0.5)\\,0.001)"
  local burst_window="lt(mod(t\\,1.0)\\,0.1)"
  local click="0.8*${click_window}*sin(2*PI*1000*t)"
  local burst="0.5*${burst_window}*sin(2*PI*${SWEEP_HZ}*t)"

  render "click-2hz" "${click}" "${click}"
  verify "click-2hz" 0.8

  render "burst-100hz-gated" "${burst}" "${burst}"
  verify "burst-100hz-gated" 0.5
}

function main() {
  if [[ $# -gt 1 ]]; then
    die "${E_USAGE}" "usage: make-test-tones [OUTDIR]"
  fi

  OUTDIR="${1:-${HOME}/Music/fosforo-test-tones}"
  readonly OUTDIR

  command -v ffmpeg > /dev/null 2>&1 ||
    die "${E_UNAVAILABLE}" "ffmpeg is not installed; try \`brew install ffmpeg\`"

  mkdir -p "${OUTDIR}"

  warn "writing ${DURATION}s tones to ${OUTDIR}"
  make_sines
  make_levels
  make_pans
  make_saws
  make_transients

  warn "every peak above was read back out of the finished file"
}

main ${1+"$@"}
