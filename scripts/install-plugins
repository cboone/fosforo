#!/usr/bin/env bash
# install-plugins — copy the built bundles into the user's plug-in folders and prove which build landed
# Author: Christopher Boone
# Date: 2026-08-05
#
# Building and installing are separate acts, and only the second decides what a
# host loads. `zig build` and `cmake --build` write into the worktree; REAPER and
# Logic read ~/Library/Audio/Plug-Ins. Nothing connects the two but a copy
# someone remembers to make, and this repository is normally checked out as
# several worktrees on several branches that all compete for that one location,
# so the installed bundle belongs to whichever of them copied last.
#
# That failure is silent and reads as a pass. A branch adding a resizable editor
# was once "verified" against an installed build whose `can_resize` returned
# false: the window edge could not be dragged, so an uneventful result was the
# only outcome available, and it looked like success.
#
# So this does not merely copy. It copies and then compares hashes, and says
# which build is now installed. An install that cannot be confirmed is worth no
# more than one that never happened.
#
# Both callers build what they are about to install, which is what makes the hashes
# below mean anything: `zig build install-clap` runs this with --clap-only behind the
# Zig install step, and `zig build install-plugins` runs it behind that and the
# audio-unit step. This script builds nothing itself.
#
# An installed bundle with no built counterpart is reported rather than ignored, and
# that is the other half of the same argument. Silence about a component nobody in
# this worktree built is what let a two-week-old Fosforo.component from another
# branch sit in ~/Library/Audio/Plug-Ins/Components while a fresh CLAP was installed
# beside it. Logic loaded the stale one, it rendered, and it read as a pass (#43).
# It is a report and not an error: the CLAP-only loop is deliberately the common
# one, and refusing to finish it would be a worse trade than saying what is there.
#
# Every bundle now carries the branch and commit it was built from, stamped in by
# build.zig and read back by scripts/read-provenance, so the reports below say whose
# build is installed rather than only whether it is this one. That matters most where
# a hash cannot: an installed component this worktree never built has nothing to be
# compared against, and used to be described only by its modification date.
#
# Usage:
#   install-plugins [--clap-only | --symlink-audio-unit]
#
#   --clap-only   Skip the Audio Unit even if it has been built. What is already
#                 installed is still reported, because the question the report
#                 answers does not go away when the copy is skipped.
#
#   --symlink-audio-unit
#                 Link the shared Components location at this worktree's build
#                 instead of copying into it, so `ls -l` answers which worktree owns
#                 it and a rebuild needs no reinstall. The Audio Unit only: a CLAP
#                 host must honour CLAP_PATH and can be pointed straight at a
#                 worktree, while AudioComponentRegistrar scans only the two standard
#                 directories and has no equivalent.
#
# Exit codes:
#   0  - Everything installed was verified against the build it came from
#  64  - Invalid arguments
#  65  - A bundle was installed and did not match its source afterwards
#  66  - Nothing was available to install

set -euo pipefail

readonly E_USAGE=64
readonly E_DATAERR=65
readonly E_NOINPUT=66

readonly PROGRAM_NAME="${0##*/}"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

readonly CLAP_DEST="${HOME}/Library/Audio/Plug-Ins/CLAP"
readonly AU_DEST="${HOME}/Library/Audio/Plug-Ins/Components"

readonly CLAP_BUNDLE="Fosforo.clap"
readonly AU_BUNDLE="Fosforo.component"

# The Mach-O inside each bundle rather than the bundle directory, because that is
# the file whose contents differ between builds and the only one worth hashing.
readonly CLAP_BINARY="Contents/MacOS/Fosforo"
readonly AU_BINARY="Contents/MacOS/Fosforo"

function warn() {
  echo "${PROGRAM_NAME}: ${*}" >&2
}

function usage() {
  cat >&2 << 'USAGE'
usage: install-plugins [--clap-only | --symlink-audio-unit]

  --clap-only            Skip the Audio Unit even if it has been built.
  --symlink-audio-unit   Link the Components location at this worktree's build
                         rather than copying into it.
USAGE
}

# The first twelve hex digits, which is plenty to tell two builds apart and short
# enough to read at a glance.
#
# Refuses rather than returning an empty string, which is what it used to do when the
# path was missing, and that was the worse of the two failures it caused. `shasum`
# wrote to stderr and exited non-zero, the assignment below took its status from the
# `echo` that followed instead, and the caller went on to compare "" against "" and
# call that a match: a run that had just deleted a working bundle reported a
# successful verified install, with a blank hash, and exited 0. A hash that cannot be
# computed is an error, not a value.
#
# Callers guard the file before asking, so reaching this is a race rather than the
# ordinary missing-file case, and it is left loud for that reason.
function short_hash() {
  local path="${1}"
  local sum

  if ! sum="$(shasum -a 256 "${path}")"; then
    warn "cannot hash ${path}"
    return "${E_NOINPUT}"
  fi

  echo "${sum:0:12}"
}

# Which worktree and which commit a bundle was built from.
#
# The hash above answers "is this the build I just made?" and can only answer it when
# this worktree has a build to compare against. This answers "whose build is this?"
# with nothing else in hand, which is the question the stale-component case actually
# poses and the one that has cost real time (#22, #43).
#
# Never fails. A bundle built before the stamp existed, or one from another project
# entirely, reports `(no provenance)` and the caller carries on: this whole file is a
# diagnostic path, and a diagnostic that aborts is worse than none.
# Arguments:
#   $1 - a bundle directory or the binary inside it
# Outputs:
#   `<branch> <commit>` on stdout, or a stand-in
function provenance() {
  "${SCRIPT_DIR}/read-provenance" --short "${1}" 2> /dev/null || true
}

# Say whether an installed bundle is a symlink, and whether it still resolves.
#
# Only `--symlink-audio-unit` creates one, but it is read on every path: once the
# shared location can hold a link, every report about what is installed has to be able
# to describe one, including the reports written before the mode existed.
# Arguments:
#   $1 - the installed bundle path
# Outputs:
#   A description on stdout, or nothing when the path is an ordinary directory
function link_note() {
  local installed="${1}"

  if [[ ! -L "${installed}" ]]; then
    return 0
  fi

  local target
  target="$(readlink "${installed}")"

  # `-e` follows the link, so this is the dangling test. A worktree that has been
  # removed, or a `rm -rf build` inside one, leaves exactly this.
  if [[ -e "${installed}" ]]; then
    echo "symlink to ${target}"
  else
    echo "DANGLING symlink to ${target}"
  fi
}

# Copy one bundle and then prove the copy is the build it came from.
#
# `rm -rf` before `cp -R` rather than copying over the top: a bundle left from a
# different branch may carry files this one does not, and merging the two
# produces something that matches neither.
#
# That `rm -rf` is also the moment this repository's central hazard happens, and it
# used to happen in silence. Whatever another worktree installed is destroyed here,
# and the run that destroys it is the one best placed to say so, because afterwards
# there is nothing left to ask. So the outgoing bundle is read before it is deleted.
function install_bundle() {
  local label="${1}"
  local source="${2}"
  local dest_dir="${3}"
  local binary="${4}"

  local installed
  installed="${dest_dir}/$(basename "${source}")"

  # Checked here rather than by the caller, and specifically *before* the `rm -rf`
  # below, because the destructive step comes first and the verification comes last.
  # A source directory with no Mach-O inside it used to pass the caller's `-d` test,
  # take the working installed bundle with it, and then be unhashable. The existence
  # of a bundle directory is not evidence that there is a build in it.
  if [[ ! -f "${source}/${binary}" ]]; then
    warn "${label}: ${source} has no ${binary}; nothing was installed"
    warn "${label}:   the build is incomplete, and whatever is installed is untouched"
    return "${E_NOINPUT}"
  fi

  # Read before the delete, which is the only time it can be read.
  local outgoing=""
  local outgoing_link=""
  if [[ -e "${installed}" ]]; then
    outgoing="$(provenance "${installed}")"
    outgoing_link="$(link_note "${installed}")"
  fi

  mkdir -p "${dest_dir}"

  # `rm -rf` on a symlink removes the link and not what it points at, which is what
  # makes this safe to run over an install left by --symlink-audio-unit. Note the
  # absent trailing slash: adding one would make this follow the link and delete the
  # worktree's own build directory.
  rm -rf "${installed}"
  cp -R "${source}" "${dest_dir}/"

  local built_hash
  local installed_hash
  built_hash="$(short_hash "${source}/${binary}")"
  installed_hash="$(short_hash "${installed}/${binary}")"

  if [[ "${built_hash}" != "${installed_hash}" ]]; then
    warn "${label}: installed ${installed_hash} does not match built ${built_hash}"
    return "${E_DATAERR}"
  fi

  local incoming
  incoming="$(provenance "${installed}")"

  warn "${label}: ${installed_hash}  ${installed}"
  warn "${label}:   built from ${incoming}"

  # Only when it says something the line above does not. Re-installing the same branch
  # over itself is the common case and does not need a second line about it; replacing
  # another worktree's build is the case this whole script exists for.
  if [[ -n "${outgoing_link}" ]]; then
    warn "${label}:   replaced a ${outgoing_link}"
  fi

  if [[ -n "${outgoing}" && "${outgoing}" != "${incoming}" ]]; then
    warn "${label}:   replaced ${outgoing}"
  fi
}

# Point the shared location at this worktree's build instead of copying into it.
#
# The Audio Unit is the only format that needs this. A CLAP host must honour
# `CLAP_PATH`, so the CLAP can be loaded straight out of a worktree and the shared
# directory avoided entirely; `AudioComponentRegistrar` scans only the two standard
# Components directories and there is no `AU_PATH`, so the Audio Unit has to land in
# the one place whatever else is true.
#
# **This does not remove staleness, it changes its shape**, and that is the whole of
# what it buys. A copy can be another branch's build with nothing here to compare it
# to; a link is always this worktree's `build/assets`, so what remains is only the
# ordinary question of whether CMake has been re-run, which the provenance line and
# the modification date both answer. `ls -l` answers the ownership question with no
# tooling at all.
#
# The hash comparison the copy path ends with would be vacuous here, since the
# installed file *is* the built file, so it is replaced by a report of where the link
# points rather than printed as a match that could not have failed.
function link_bundle() {
  local label="${1}"
  local source="${2}"
  local dest_dir="${3}"
  local binary="${4}"

  local installed
  installed="${dest_dir}/$(basename "${source}")"

  # Same guard and the same reasoning as the copy path: the destructive step comes
  # first, so a source with no Mach-O in it must not take the working install with it.
  if [[ ! -f "${source}/${binary}" ]]; then
    warn "${label}: ${source} has no ${binary}; nothing was linked"
    warn "${label}:   the build is incomplete, and whatever is installed is untouched"
    return "${E_NOINPUT}"
  fi

  local outgoing=""
  local outgoing_link=""
  if [[ -e "${installed}" ]]; then
    outgoing="$(provenance "${installed}")"
    outgoing_link="$(link_note "${installed}")"
  fi

  mkdir -p "${dest_dir}"
  rm -rf "${installed}"
  ln -s "${source}" "${installed}"

  # Asserted rather than assumed. `ln` is quiet about a great deal, and a link that
  # resolves to nothing looks identical to a working one in every listing that does
  # not follow it.
  if [[ ! -f "${installed}/${binary}" ]]; then
    warn "${label}: linked ${installed} but it does not resolve to a binary"
    return "${E_DATAERR}"
  fi

  warn "${label}: linked  ${installed}"
  warn "${label}:   -> ${source}"
  warn "${label}:   built from $(provenance "${installed}")"
  warn "${label}:   a rebuild here now changes what the host loads, with no reinstall"

  if [[ -n "${outgoing_link}" ]]; then
    warn "${label}:   replaced a ${outgoing_link}"
  elif [[ -n "${outgoing}" ]]; then
    warn "${label}:   replaced a copy built from ${outgoing}"
  fi
}

# Describe a bundle that is installed and was not installed by this run.
#
# The hash alone is not enough here, because there is nothing to compare it to. The
# date used to be the only thing that made it legible: a component from a fortnight
# ago, next to a CLAP from a minute ago, is the whole tell, and it is the one that was
# missed (#43).
#
# **Provenance is what turns that tell into a statement.** A date invites an
# inference; a branch name ends the question. This is the exact case the stamp was
# added for, because it is the one where no hash comparison is possible at all.
#
# Arguments:
#   $1 - label for the message
#   $2 - the installed bundle directory
#   $3 - the binary inside it, relative to the bundle
function describe_installed() {
  local label="${1}"
  local installed="${2}"
  local binary="${3}"

  local hash
  local modified
  hash="$(short_hash "${installed}/${binary}")"
  modified="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "${installed}/${binary}")"

  warn "${label}:   installed ${hash}, modified ${modified}"
  warn "${label}:   built from $(provenance "${installed}")"

  local note
  note="$(link_note "${installed}")"
  if [[ -n "${note}" ]]; then
    warn "${label}:   ${note}"
  fi
}

# Report on an Audio Unit that this run is not going to install over.
#
# Three of the four cases the caller can be in end up here, and they differ in what
# is knowable rather than in what happened. With a built component in hand the
# installed one can be compared and the answer is exact; without one, the date above
# is the only evidence there is.
#
# Arguments:
#   $1 - path to the built component, which may not exist
#   $2 - true when the skip was asked for rather than forced
function report_audio_unit() {
  local built="${1}"
  local skipped="${2}"

  local installed="${AU_DEST}/${AU_BUNDLE}"

  # Before the `-d` test below, which follows symlinks and would therefore call a
  # dangling one "none installed". That is the wrong report and the misleading half of
  # it is the reassuring half: a dangling link *is* installed, is what a host finds,
  # and resolves to nothing. It is what a removed worktree or a `rm -rf build` inside
  # one leaves behind, so it is the ordinary failure of --symlink-audio-unit rather
  # than an exotic one.
  if [[ -L "${installed}" && ! -e "${installed}" ]]; then
    warn "audio unit: ${installed} is a $(link_note "${installed}")"
    warn "audio unit:   Logic will find nothing there, and say nothing about it"
    warn "audio unit:   rebuild in the worktree it names, or reinstall from here"
    return 0
  fi

  if [[ ! -d "${installed}" ]]; then
    if [[ "${skipped}" == true ]]; then
      warn "audio unit: skipped by --clap-only, and none is installed"
    else
      warn "audio unit: none built and none installed"
      warn "audio unit:   Logic loads no CLAP; run \`zig build audio-unit\` if you need it"
    fi
    return 0
  fi

  # A bundle directory whose Mach-O is missing is installed and unreadable, which is
  # neither of the two states below and cannot be hashed into either of them. It is
  # reported rather than hashed because this whole function is the diagnostic path:
  # it runs after the CLAP has already been installed, so a `shasum` that takes the
  # run down with it turns a successful install into a non-zero exit and swallows the
  # provenance line that follows. A diagnostic that aborts is worse than none.
  if [[ ! -f "${installed}/${AU_BINARY}" ]]; then
    warn "audio unit: ${installed} has no ${AU_BINARY}"
    warn "audio unit:   damaged rather than stale, and a host will refuse it"
    warn "audio unit:   \`zig build install-plugins\` will build one and replace it"
    return 0
  fi

  # The built bundle gets the same treatment for the same reason. Falling through to
  # the report below is right: an incomplete build is not something that can replace
  # what is installed, which is exactly what that branch says.
  if [[ -f "${built}/${AU_BINARY}" ]]; then
    local built_hash
    local installed_hash
    built_hash="$(short_hash "${built}/${AU_BINARY}")"
    installed_hash="$(short_hash "${installed}/${AU_BINARY}")"

    if [[ "${built_hash}" == "${installed_hash}" ]]; then
      warn "audio unit: skipped by --clap-only; the installed one IS this build"
      warn "audio unit:   ${installed_hash}  ${installed}"
    else
      warn "audio unit: skipped by --clap-only; the installed one is NOT this build"
      warn "audio unit:   installed ${installed_hash}, built ${built_hash}"
      warn "audio unit:   installed built from $(provenance "${installed}")"
      warn "audio unit:   drop --clap-only to replace it"
    fi

    # Reported in both branches, because a link makes the comparison above tautological
    # rather than informative: the installed file is the built file, so the hashes
    # cannot disagree and the reader should know that is why they agree.
    local note
    note="$(link_note "${installed}")"
    if [[ -n "${note}" ]]; then
      warn "audio unit:   ${note}"
    fi

    return 0
  fi

  warn "audio unit: NOT from this build"
  describe_installed "audio unit" "${installed}" "${AU_BINARY}"
  warn "audio unit:   nothing was built here to replace it"
  warn "audio unit:   Logic will load that bundle; run \`zig build audio-unit\` first"
}

function main() {
  local clap_only=false
  local symlink_au=false

  while [[ "${#}" -gt 0 ]]; do
    case "${1}" in
      --clap-only)
        clap_only=true
        shift
        ;;
      --symlink-audio-unit)
        symlink_au=true
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        warn "unknown argument: ${1}"
        usage
        return "${E_USAGE}"
        ;;
    esac
  done

  # They do not conflict so much as cancel: --clap-only means the Audio Unit is not
  # touched at all, so there is nothing for --symlink-audio-unit to do. Refused rather
  # than silently ignored, because the two together read as a request that was
  # honoured and it would not have been.
  if [[ "${clap_only}" == true && "${symlink_au}" == true ]]; then
    warn "--clap-only and --symlink-audio-unit cancel: the first installs no Audio Unit"
    return "${E_USAGE}"
  fi

  local root
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

  local clap_source="${root}/zig-out/${CLAP_BUNDLE}"
  local au_source="${root}/build/assets/${AU_BUNDLE}"

  local installed_any=false

  if [[ -d "${clap_source}" ]]; then
    install_bundle "clap" "${clap_source}" "${CLAP_DEST}" "${CLAP_BINARY}"
    installed_any=true
  else
    warn "no ${CLAP_BUNDLE} in zig-out; run \`zig build\` first"
  fi

  if [[ "${clap_only}" != true && -d "${au_source}" ]]; then
    if [[ "${symlink_au}" == true ]]; then
      link_bundle "audio unit" "${au_source}" "${AU_DEST}" "${AU_BINARY}"
    else
      install_bundle "audio unit" "${au_source}" "${AU_DEST}" "${AU_BINARY}"
    fi
    installed_any=true
  else
    # Not an error, in any of its three shapes. The CLAP-only loop is the common
    # one and is meant to stay cheap; what changes here is that it no longer stays
    # quiet about a component it is leaving behind.
    report_audio_unit "${au_source}" "${clap_only}"
  fi

  if [[ "${installed_any}" != true ]]; then
    warn "nothing to install"
    return "${E_NOINPUT}"
  fi

  warn "a host will now load the hashes above; compare them before trusting any result it gives you"
}

main ${1+"$@"}
