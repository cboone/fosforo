#!/usr/bin/env -S uv run --quiet --with pillow --with numpy python
"""Measure a Fosforo trace out of a screenshot.

The verification steps talk in backing pixels: a peak on row 54 rather than row
30 is the whole of the level check, and no eye reads that off a screen. This
reports the numbers instead.

    screencapture -o -x -t png -W shot.png    # click the plugin window
    measure-trace shot.png

Every flag there is load-bearing. `-o` drops the window's drop shadow, which is
dark with a blue cast over a dark desktop and otherwise reads as more drawable.
`-t png` forces lossless: a lossy capture smears the trace into a halo tens of
pixels deep, which moved a full-scale signal's measured peak onto the rail. That
was measured against the one-pixel line #57 replaced, and a beam with its own
falloff makes the two harder to tell apart by eye, not easier — the colour guard
below is what separates them now. `-W` picks the window so the whole editor is in
frame; the crop is found from the background rather than given.

On a Retina display this writes backing pixels, which is the unit the plan's
tables are in. Terminal needs Screen Recording permission or the capture comes
back empty.

A capture is refused when it holds colours this shader cannot produce, which is
what catches a recompressed or resampled screenshot. `--explain` prints the
distribution that check is read off, and is how its two constants were set and
how they get re-derived.

**A screenshot is written in the display's colour space, not the framebuffer's**,
so this converts to sRGB before measuring anything. See `to_srgb`: on a P3 display
the numbers in the file are not the numbers the shader wrote, and the discrepancy
hides at the low end where it is easiest to check.
"""

import argparse
import io
import math
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image, ImageCms, UnidentifiedImageError

# This project's display contract, restated. Seven numbers this file does not own
# and cannot derive, copied from three files in two other languages, with a test on
# the Zig side reading this script and asserting all seven still agree. Without
# that test a constant that moved would leave everything below reporting
# confident numbers against the old mapping.
#
# **No name here may end with another's.** The Zig side finds each by substring
# and takes the first match, so a `TRACE_FULL_SCALE` declared above `FULL_SCALE`
# would silently repoint that assertion at the wrong number. The test counts
# occurrences for exactly that reason.
#
# **#60 replaced two of them and added three, and the renames are deliberate.**
# The drawable moved to `BGRA8Unorm_sRGB`, so the shader writes linear light and
# the hardware encodes on write; and the trace stopped carrying a colour, which
# moved to a gradient the shader looks up. `BACKGROUND` and `BEAM` therefore both
# changed meaning without changing role, which is the one case a textual
# comparison cannot catch, so both were renamed and a stale copy of this file now
# fails the constants test loudly instead.
FULL_SCALE = 0.9  # iface.trace_full_scale
RAIL = 0.98

# `iface.beam_width_points`. How wide the beam draws, in points, which becomes
# backing pixels only after the display's scale is applied — hence `--scale`,
# which this tool can no more read off a screenshot than it can the refresh rate.
#
# Only the trail heuristic uses it. The centroid deliberately does not: a
# symmetric profile's weighted centre is its centre whatever its width, which is
# what lets the vertical numbers here stay independent of a value the capture
# cannot confirm.
BEAM_WIDTH_POINTS = 3.0

# This machine's panel, on the same footing as DEFAULT_REFRESH_HZ: a screenshot
# carries neither its display's scale nor its refresh rate, so both are arguments
# with a local default rather than anything read from the file.
DEFAULT_SCALE = 2.0  # iface.trace_rail
BACKGROUND_BYTES = (5.0, 5.0, 8.0)  # palette.background_bytes
CORE_EXPONENT = 4  # palette.core_exponent
WHITE_HEADROOM = 0.8  # palette.white_headroom
TAU_NS = 158187026  # palette.decay_tau_nanos

# The refresh rate a capture is assumed to have been taken at.
#
# **#56 gave this file a dependency it did not have before, and it is a real one
# rather than bookkeeping.** The decay is now `exp(-dt / TAU_NS)`, so the white
# point `WHITE_HEADROOM / (1 - decay)` depends on how fast the display was
# refreshing when the screenshot was taken: 8.0 at 60 Hz and 15.6 at 120. Both
# numbers below are read through it, and they are affected very differently.
#
# `lit_threshold` barely moves, because at an energy of 0.231 deposits the
# tonemap's shoulder term is negligible: across 48 to 240 Hz, where the white
# point runs from 6.5 to 30.8, the dominant channel's lit byte goes 120.62,
# 120.52, 120.37, 120.33 — three tenths of a byte across the whole range. **It
# does change the reported integer, and only by bad luck**: the value straddles
# 120.5, so this prints 121 at and below 60 Hz and 120 at and above 120. One level
# on a threshold is nothing to a persistence envelope, and it is worth knowing
# before wondering why a re-measured capture moved.
#
# `energy_from_tonemapped` moves a great deal, because inverting the curve near
# saturation is exactly where the white point does its work: a pixel at `t = 0.9`
# reads 5.0 deposits at 60 Hz and 7.0 at 120, a 39% difference in the one number a
# retune would be done against. That measurement is why `--refresh` exists and why
# this is not simply pinned to the reference rate.
#
# 120 by default because that is this machine's panel at its usual rate, and
# because a capture taken while ProMotion was idling lower is the case worth
# passing a flag for rather than the case worth defaulting to.
DEFAULT_REFRESH_HZ = 120.0

# The four gradients, authored in sRGB, in the order the shader's `palette_row`
# selects them: green, amber, storage-tube blue, neutral.
#
# Each has its largest component at exactly 1.0, and that is the property this
# whole file rests on rather than a coincidence of taste. It makes that channel an
# affine function of the tonemapped value, so one channel of a capture inverts the
# picture exactly and the other two are predicted from it. A re-tint that broke it
# would leave every measurement below reading a curve it no longer describes.
# Named one per line rather than as a nested tuple, because the Zig side reads
# these by finding an anchor and then the next `(`: a tuple of tuples would hand it
# the outer parenthesis and it would parse nothing.
TINT_GREEN = (0.30, 1.00, 0.45)  # P31, and the colour phase 2's trace drew
TINT_AMBER = (1.00, 0.69, 0.00)  # P3, the amber terminal phosphor
TINT_BLUE = (0.35, 0.60, 1.00)  # P11, the storage-tube blue
TINT_NEUTRAL = (1.00, 1.00, 1.00)  # no tint at all, for reading rather than looking

TINTS = (TINT_GREEN, TINT_AMBER, TINT_BLUE, TINT_NEUTRAL)

# sRGB, IEC 61966-2-1. The drawable's transfer function, applied by the
# render-output stage on write and undone here to get back to what the shader
# computed. `src/gpu/measure.zig` holds the same arithmetic on the Zig side; the
# constants test ties the literals, and nothing ties these two implementations
# beyond both being the published formula.
SRGB_KNEE_LINEAR = 0.0031308
SRGB_KNEE_ENCODED = 0.04045
SRGB_SLOPE = 12.92
SRGB_GAMMA = 2.4
SRGB_SCALE = 1.055
SRGB_OFFSET = 0.055


def srgb_encode(linear):
    """Linear light to the 0-1 value an sRGB drawable stores."""
    c = np.clip(np.asarray(linear, dtype=np.float64), 0.0, 1.0)
    return np.where(
        c <= SRGB_KNEE_LINEAR,
        SRGB_SLOPE * c,
        SRGB_SCALE * np.power(c, 1.0 / SRGB_GAMMA) - SRGB_OFFSET,
    )


def srgb_decode(encoded):
    """The inverse, for reading a capture back as the light the shader wrote."""
    s = np.clip(np.asarray(encoded, dtype=np.float64), 0.0, 1.0)
    return np.where(
        s <= SRGB_KNEE_ENCODED,
        s / SRGB_SLOPE,
        np.power((s + SRGB_OFFSET) / SRGB_SCALE, SRGB_GAMMA),
    )


# The background in the two forms the rest of this file needs it in.
#
# **The bytes are what is stated and the linear value is the derivation**, which
# is the opposite of how this file used to hold it and is not a style choice. The
# crop looks for exact bytes; deriving them through the transfer function would
# put a conversion between the constants test and the thing that actually
# depends on the number, and a mistake there would crop a black region and report
# rows for it rather than failing.
BG8 = BACKGROUND_BYTES
BG_LINEAR = tuple(c / (255.0 * SRGB_SLOPE) for c in BACKGROUND_BYTES)


def palette(tint, t, channel):
    """One gradient's linear-light value at a tonemapped value, per channel.

    The closed form `src/gpu/palette.zig` builds its table from. The shader reads
    that table and interpolates between neighbours rather than evaluating this,
    which at 256 entries differs from the closed form by 0.004 of a byte — three
    orders of magnitude inside the tolerance below, so predicting from the formula
    rather than from a rebuilt table costs nothing and saves this file a copy of
    the table's geometry.
    """
    t = np.clip(np.asarray(t, dtype=np.float64), 0.0, 1.0)
    background = BG_LINEAR[channel]
    linear = srgb_decode(tint[channel])
    hue = linear + (1.0 - linear) * t**CORE_EXPONENT
    return background + (1.0 - background) * hue * t


def dominant(tint):
    """The channel a gradient drives to exactly 1.0, and therefore inverts on."""
    return int(np.argmax(tint))


def tonemapped_from_dominant(tint, byte):
    """The tonemapped value a byte of the dominant channel implies, exactly.

    That channel's tint component is 1.0, so `mix(tint, 1, w)` leaves it at 1 for
    every weight and the gradient reduces to `bg + (1 - bg) t` there. Exact rather
    than fitted, which is what lets the other two channels be predicted rather
    than tolerated.
    """
    background = BG_LINEAR[dominant(tint)]
    linear = srgb_decode(np.asarray(byte, dtype=np.float64) / 255.0)
    return (linear - background) / (1.0 - background)


def white_point(refresh_hz):
    """Where the tonemap saturates, in deposits, for a capture at this rate.

    `palette.whitePoint(palette.decayOver(1 / refresh_hz))`, restated. The white
    point is derived from the decay rather than fixed, so that a dwelling beam's
    steady state and the point white is anchored at track the refresh rate
    together; since #56 made the decay a function of elapsed time that is a live
    dependency rather than a property held in reserve.
    """
    decay = math.exp(-1e9 / (refresh_hz * TAU_NS))
    return WHITE_HEADROOM / max(1.0 - decay, 1e-6)


def energy_from_tonemapped(t, white):
    """Invert the curve, so a capture can report the energy behind a colour.

    Extended Reinhard `t = e(1 + e/w²)/(1 + e)` rearranges to a quadratic in `e`:
    `e²/w² + e(1 - t) - t = 0`. Reported rather than asserted on, because it is
    the number that makes retuning possible from a screenshot instead of from a
    guess, and because it saturates: at or above the white point the curve has
    stopped distinguishing, which is the brightness axis's rail and is exactly
    what `RAIL` is on the vertical one.

    This is the reading `--refresh` matters most to. Near saturation the shoulder
    term is the whole answer, so a `t` of 0.9 reads 5.0 deposits against a 60 Hz
    white point and 7.0 against a 120 Hz one.
    """
    a = 1.0 / (white * white)
    b = 1.0 - t
    if t >= 1.0:
        return float("inf")
    return (-b + np.sqrt(b * b + 4.0 * a * t)) / (2.0 * a)


# How far a capture may stray from the exact background before a pixel stops
# counting as background, and how far the blue lead may stray from its nominal 3.
# Both are empirical: they describe what the screen-capture path does to a value,
# not what the shader writes, which is why they are numbers here rather than
# derived from BACKGROUND_BYTES the way the centres are.
BG_WINDOW = 2
LEAD_WINDOW = 1

# The colour guard. See `ray_deviation` for what it tests and why the shade count
# it replaced stopped working.
#
# **Re-derived for #60 rather than carried forward.** The pre-#60 pair was 0.0074%
# lossless against 23.7% at quality 60, measured against a straight ray; the
# picture is a curve now and every number below comes from two fresh REAPER
# captures at 1920x1080, a 100 Hz sine at 0.5 and a level-2.000 sine, each read
# after `to_srgb`:
#
#                      sine 0.5    level 2.000
#   lossless             0.02%         0.02%
#   JPEG q95            22.19%        34.39%
#   JPEG q80            30.35%        43.70%
#   JPEG q60            28.34%        41.96%
#
# Three orders of magnitude, which is the same margin the ray had and is what
# makes the threshold need no calibration against the machine it runs on: it sits
# 25x above a good capture and 1100x below a recompressed one.
#
# **A tolerance of 1 is what makes this a floor rather than a preference.** At 1 a
# good pre-#57 capture read 2.01% and 3.49%, both above the threshold, so it would
# refuse the very pictures this tool exists to measure.
#
# **#57 moved it from 2 to 3, and the old value was refusing good captures.** A
# beam with a falloff skirt puts about one percent of the drawable in the
# gradient's toe, where the sRGB curve is coarsest — `src/gpu/palette.zig` records
# 3294.6 bytes per unit linear there — and quantization in that region reaches
# three levels where a one-pixel trace only ever reached two. Re-derived on the
# same two captures the rows above use, both taken in REAPER at 1920x1080 and read
# after `to_srgb`, each against itself recompressed:
#
#                    sine 0.5                      level 2.000
#              lossless  q95     q80     q60   lossless  q95     q80     q60
#   tolerance 2   1.29%  38.18%  45.85%  42.61%   0.71%  76.56%  83.99%  86.32%
#   tolerance 3   0.26%  35.30%  43.37%  40.09%   0.15%  68.63%  77.62%  78.70%
#
# **At 2 both good captures sit above MAX_OFF_RAY and are refused**, which is not
# a marginal call: 1.29% and 0.71% against a 0.5% line. At 3 they read 0.26% and
# 0.15%, so the threshold sits 1.9x and 3.3x above them and 137x below the worst
# recompression, and good against lossy is 135x and 457x. The same three orders of
# magnitude the pre-#57 pair had, which is what keeps this needing no calibration
# against the machine it runs on.
RAY_TOLERANCE = 3
MAX_OFF_RAY = 0.005

# The exclusion stopped being inert at #57, which is what it was kept for.
#
# The premise has never changed: the dominant channel saturates first, and a
# saturated pixel carries no usable `t` because the others keep climbing behind
# one that cannot. What changed is how much there is to exclude. Before #60 it
# removed 3774 pixels of a capture; after #60, **two**, because almost nothing
# reached the white point. After #57 a level-2.000 capture has **8338** of
# 2,073,600 excluded, because overlap at the joints of a wide beam reaches the
# white point where a one-pixel line did not.
#
# So the note that used to sit here — that this was a fact about `white_headroom`
# being provisional, and that #58 would make it matter again — was right about the
# direction and wrong about which issue. #58 will widen it further.
SATURATED = 250

# The energy at which a pixel counts as lit, and the reason `--threshold` is
# derived rather than defaulted to a byte.
#
# **A fixed byte would have doubled the persistence envelope this tool reports
# without saying so.** Before #60 the resolve was linear, so the old default of 64
# meant an energy of 0.231, about thirteen frames of trail at a decay of 0.9.
# Under the sRGB toe and the tonemap the same byte is an energy of 0.052, about
# twenty-eight frames: the same number, a different measurement, and nothing in
# the output would have marked the change. Stating the energy and computing the
# byte is what keeps a capture comparable with #38's tables.
LIT_ENERGY = 0.231


def lit_threshold(tint, white):
    """The dominant channel's byte at which a pixel counts as lit.

    Nearly insensitive to `white`, which was measured rather than assumed: across
    the whole 48 to 240 Hz range the white point moves from 6.5 to 30.8 and this
    lands between 120.33 and 120.62, because `LIT_ENERGY` sits low on the curve
    where the shoulder term is negligible. The rounding straddles that span, so
    the integer returned is 121 below about 90 Hz and 120 above it. See
    `DEFAULT_REFRESH_HZ`.
    """
    e = LIT_ENERGY
    t = min(e * (1.0 + e / (white * white)) / (1.0 + e), 1.0)
    return round(float(srgb_encode(palette(tint, t, dominant(tint)))) * 255.0)


def open_image(path):
    """Open a capture whatever container macOS put it in.

    A screenshot named `.png` is not necessarily a PNG: depending on how it was
    taken, macOS writes HEIC and leaves the extension alone, and Pillow reads
    neither HEIC nor several other things the screen-capture path can produce.
    `sips` is part of the base OS and reads everything Apple's imaging stack
    does, so an unreadable file gets one conversion attempt before being called
    unreadable.
    """
    try:
        return Image.open(path)
    except UnidentifiedImageError:
        pass
    except FileNotFoundError:
        sys.exit(f"no such file: {path}")

    with tempfile.TemporaryDirectory() as tmp:
        converted = Path(tmp) / "converted.png"
        # `check=False` explicitly: a failed conversion is an ordinary outcome
        # here, reported by the returncode test below with a message about Screen
        # Recording permission, and raising instead would replace that with a
        # traceback.
        done = subprocess.run(
            ["sips", "-s", "format", "png", str(path), "--out", str(converted)],
            capture_output=True,
            check=False,
        )
        if done.returncode != 0 or not converted.exists():
            sys.exit(
                f"{path} is not an image Pillow or sips can read.\n"
                "If it came from `screencapture`, an empty or truncated file usually "
                "means Terminal lacks Screen Recording permission:\n"
                "  System Settings > Privacy & Security > Screen & System Audio Recording"
            )
        print(f"converted {Path(path).suffix or 'the capture'} to png via sips")
        return Image.open(converted).copy()


def to_srgb(img):
    """Undo the display's colour space, which is what a screenshot is written in.

    **This is the difference between the colour guard working and not, and it is
    invisible until measured.** The plugin writes into a `BGRA8Unorm` drawable,
    whose values the compositor treats as sRGB; the compositor then converts them
    for whatever display is showing them, and `screencapture` writes those
    *display* values with the display's profile attached. On a P3 display the
    numbers in the file are therefore not the numbers the shader wrote.

    What makes it a trap rather than an inconvenience is where the distortion
    lives. It is proportional to saturation and vanishes at black, so the
    background survives as exactly `RGB(5, 5, 8)` and the capture looks faithful
    at precisely the point anyone would check it. Measured on a real REAPER
    capture at 2018x1778, before and after this conversion:

        green 200-240   red 119.0 -> 70.9   against a predicted 70.9
        off the ray        2.7372% -> 0.0074%
        max deviation        55.73 -> 8.64

    The green channel barely moves, so every row this tool reports is unchanged:
    that capture's peak row is 459 either way, and #38's published tables are not
    affected. What the conversion fixes is chroma, which is all the guard reads.

    A file with no profile is taken as sRGB already, which is the honest default
    and is what a synthesized or hand-made image will be.

    The name reported back is whatever the profile calls itself, which for a
    calibrated display is often just "Display". That is not this function failing
    to identify it; `sips` names the same capture's profile "Display P3" only
    after rewriting it.
    """
    icc = img.info.get("icc_profile")
    rgb = img.convert("RGB")
    if icc is None:
        return rgb, None

    source = ImageCms.ImageCmsProfile(io.BytesIO(icc))
    converted = ImageCms.profileToProfile(
        rgb, source, ImageCms.createProfile("sRGB"), outputMode="RGB"
    )
    return converted, ImageCms.getProfileDescription(source).strip()


def find_drawable(rgb):
    """Bounding box of Fosforo's own surface inside a larger screenshot.

    The background is RGB(5, 5, 8), whose giveaway is the blue channel sitting
    three above red and green. A host's chrome is grey or coloured and a pure
    grey fails that lead, so this does not need the capture cropped by hand: grab
    the whole window and let the background find itself. Returns None when no
    such region exists, which is the honest answer both for a capture of the
    wrong thing and for one recompressed past the point where the background
    survives.
    """
    r, g, b = rgb[:, :, 0], rgb[:, :, 1], rgb[:, :, 2]
    # Tight, because a window's drop shadow over a dark desktop is also near
    # black with a blue cast and fooled a looser test: it stretched the detected
    # region 119 rows past the real drawable. So this looks for the background's
    # own value, and for the blue lead of 3 that 0.03-against-0.02 produces
    # rather than for a merely positive one.
    #
    # **Tolerant rather than exact, and that is not an oversight.** The shader
    # writes exactly RGB(5, 5, 8) into the framebuffer; this reads a screenshot,
    # which `to_srgb` explains is a different thing, identity at the background
    # only to within rounding. BG_WINDOW and LEAD_WINDOW are what absorb that and
    # their declarations say so. Do not tighten them to zero on the strength of
    # the word "exactly" anywhere else in this file.
    #
    # The centres come from BACKGROUND_BYTES rather than being written out, so the
    # one place this file states the background is the one the constants test
    # checks. Only the windows either side are this function's own.
    want = [round(c) for c in BG8]
    lead = want[2] - want[0]
    bg = (
        (abs(r - want[0]) <= BG_WINDOW)
        & (abs(g - want[1]) <= BG_WINDOW)
        & (abs(b - want[2]) <= BG_WINDOW)
        & (abs(b - r - lead) <= LEAD_WINDOW)
        & (abs(b - g - lead) <= LEAD_WINDOW)
    )
    if bg.sum() < 1000:
        return None
    rows, cols = np.where(bg)
    return int(cols.min()), int(rows.min()), int(cols.max()) + 1, int(rows.max()) + 1


def ray_deviation(rgb, tint):
    """How far each unsaturated pixel sits from the colour this shader can produce.

    Everything the renderer puts on the drawable is one gradient's value at some
    tonemapped `t`, so the whole picture lies on a one-dimensional curve through
    colour space. The gradient's dominant channel is an exact affine function of
    `t`, so it inverts the curve, and the other two then follow exactly rather
    than approximately.

    **#60 bent the ray into a curve and the guard kept its shape**, which is worth
    stating because the premise it replaced sounded just as solid. Before, every
    deposit was one colour and the decay multiplied the whole vector, so a lit
    pixel was `background + c * beam` and the population was a straight ray.
    Now the beam deposits a scalar and the colour comes from a lookup that runs
    toward white, so the population is a curve. Both are one-dimensional, which is
    all this check ever needed: a capture that has been resampled or recompressed
    leaves the manifold whatever its shape, because chroma subsampling puts one
    channel where its partners are not.

    Two things follow, and neither is optional. The capture is **decoded to linear
    before inverting**, because the drawable is `BGRA8Unorm_sRGB` and a screenshot
    therefore holds the curve's image under a non-linear map. And the prediction is
    **encoded back before comparing**, so the deviation stays in the 8-bit levels
    the tolerance is stated in; comparing decoded values would put the tolerance in
    linear units, where one level is 3.0e-4 near black and 0.009 near white, and a
    single number could not mean anything in both places.

    **This replaces a count of distinct green levels, whose premise #55 ended.**
    That guard refused any capture holding more than 32 shades, on the stated
    ground that a lossless one holds two: true of a trace with no persistence and
    false the moment one fades, because a decaying trail occupies dozens of levels
    by construction. It refused good PNGs and told the author to recapture them.

    The ray survives persistence for the reason the count does not: decay scales
    all three channels together, so a fading pixel slides along the ray rather
    than off it. What leaves the ray is resampling and chroma subsampling, which
    put green into neighbouring pixels without their red and blue partners, and
    ringing, which puts red and blue where there is no green. So this refuses a
    strictly wider set of bad captures than the count did, including a screenshot
    taken on a scaled display, which the count could not see at all.

    Returns one deviation per unsaturated pixel, in 8-bit levels, and how many
    that was: the larger of the red and blue distances, since a pixel is off the
    ray when either channel is, and the count separately because a fraction of
    nothing has to be reported as such rather than as zero.
    """
    channels = [rgb[:, :, i].astype(np.float64) for i in range(3)]
    lead = dominant(tint)

    # The dominant channel saturates first, and a saturated pixel carries no
    # usable `t`: the others keep climbing behind one that cannot. Excluded rather
    # than tolerated, since the beam dwelling on a pixel is exactly where the
    # picture is brightest and most worth measuring.
    usable = channels[lead] < SATURATED
    examined = int(usable.sum())
    if examined == 0:
        return np.empty(0, dtype=np.float64), 0

    t = tonemapped_from_dominant(tint, channels[lead])

    worst = None
    for c in range(3):
        if c == lead:
            continue
        want = srgb_encode(palette(tint, t, c)) * 255.0
        distance = np.abs(channels[c] - want)
        worst = distance if worst is None else np.maximum(worst, distance)

    return worst[usable], examined


def off_ray(deviation, examined):
    """Fraction of unsaturated pixels holding a colour this shader cannot produce.

    `None` when there are no unsaturated pixels at all, which is emphatically not
    the same as 100%: it is the absence of an answer rather than the worst one.
    Returning a fraction there made the guard announce "100.0% of 0 unsaturated
    pixels are colours this shader cannot produce" and blame a codec for an image
    that simply had nothing in it to measure.
    """
    if examined == 0:
        return None
    return float((deviation > RAY_TOLERANCE).mean())


def explain_ray(deviation, examined):
    """Report what sets RAY_TOLERANCE and MAX_OFF_RAY, so neither has to be a guess.

    The two constants are the only judgement calls in the guard, and picking them
    from one aggregate number would be picking them blind. This prints the
    distribution instead, and the fraction each candidate tolerance would refuse,
    so a threshold can be read off a table and re-derived later by anyone holding
    the same capture.

    It exists in the tool rather than as a probe beside it deliberately. #38's
    verification produced exactly one throwaway offscreen probe, it lived on one
    machine, and it is gone; losing this tool the same way is what #64 is about.
    """
    if examined == 0:
        print("every pixel is saturated, so there is no ray to measure against")
        return

    print()
    print(f"ray deviation across {examined} unsaturated pixels, in 8-bit levels")
    for label, value in (
        ("median", float(np.percentile(deviation, 50))),
        ("99th", float(np.percentile(deviation, 99))),
        ("99.9th", float(np.percentile(deviation, 99.9))),
        ("max", float(deviation.max())),
    ):
        print(f"  {label:<8} {value:7.2f}")

    print()
    print("  tolerance   would refuse")
    for tolerance in (1, 2, 3, 4):
        fraction = float((deviation > tolerance).mean())
        here = "  <- RAY_TOLERANCE" if tolerance == RAY_TOLERANCE else ""
        print(f"  {tolerance:>9}   {fraction:12.4%}{here}")
    print(f"  refusing above {MAX_OFF_RAY:.4%}")


def lit_rows(img, threshold, channel):
    """Topmost and bottommost lit row per column, or -1 where the column is dark."""
    # The palette's dominant channel, which is an affine function of the tonemapped
    # value and therefore the trace's own readout. Luminance would also catch the
    # background's blue, and any other channel washes out at the low end where the
    # tint is weakest.
    lead = np.asarray(img.convert("RGB"), dtype=np.int16)[:, :, channel]
    lit = lead > threshold
    any_lit = lit.any(axis=0)
    top = np.where(any_lit, lit.argmax(axis=0), -1)
    bottom = np.where(any_lit, lit.shape[0] - 1 - lit[::-1].argmax(axis=0), -1)
    return top, bottom, any_lit


def implied_sample(row, height):
    """Invert the documented mapping: row -> NDC -> sample value.

    The row's *centre*, so `row + 0.5`: a pixel is a square, the mapping is about
    points, and `[[position]]` in a fragment is window space with pixel centres at
    half-integers.

    **That term was missing until #57, and the reason it was tolerable is the
    reason it stopped being.** `src/gpu/measure.zig` always carried it and said so
    at its own copy, on the grounds that half a pixel sat inside the one-pixel band
    every assertion was stated in and reconciling the two was nobody's business.
    The centroid ended that: the harness now asserts silence to a twentieth of a
    pixel, so a half-pixel offset here is ten times the tolerance on the other side
    and the two instruments would disagree about a capture they both measured
    correctly.

    Numbers published before #57 were read off a lit edge, which this term is
    small against; the ones published after it are comparable with the harness's.
    """
    y = 1.0 - 2.0 * (row + 0.5) / height
    return y / FULL_SCALE


def centroid_rows(img, channel, threshold):
    """Centre row of a column's first and last lit runs, or NaN where it is dark.

    The estimator every vertical number below is read from, and #57 is why it
    exists. Before it the beam was one device pixel, so the topmost lit row *was*
    the trace. A beam with width and a falloff has an interior, and the topmost
    lit row is then its threshold contour's upper edge, sitting above the true
    centreline by the lit half-width.

    **The bias is small and it is not noise**, which is what makes it worth a
    second estimator rather than a wider tolerance. A 3-point beam on a 2x display
    is a half-width of 3 backing pixels; at a drawable 1080 rows tall that is
    three times `pixelTolerance`, the band every assertion in this project is
    stated in. `src/gpu/measure.zig` made the same move for the same reason, and
    the two have to agree or this tool stops being that one's counterpart.

    Weighted on the dominant channel's level rather than on energy, because a
    screenshot is a picture and there is no energy in it. That is enough: the
    profile is symmetric about the centreline and the mapping from energy to level
    is monotone, so the weighted centre of a symmetric beam is still its centre.
    Exact inversion is `src/gpu/measure.zig`'s job, on the linear accumulation.

    The background is subtracted before weighting. It is small, but it is present
    in every one of a column's ~1000 dark pixels and would otherwise drag every
    centroid toward the middle of the image.

    **Weighted over one contiguous run of lit pixels, not over the column, and
    that distinction is the whole difference between this and its Zig
    counterpart.** `src/gpu/measure.zig` sums whole columns because the harness
    drives a single deposit into a cleared accumulation, so a column holds one
    beam and nothing else. A host screenshot holds a *trail*: the same column
    carries every position the beam occupied over the persistence window, and
    averaging all of it returns the centre of the fade rather than the beam.

    Measured, because the first version of this function did exactly that. On a
    100 Hz sine at 0.5 captured in REAPER at 1920x1080, whole-column centroids
    reported a peak of +0.0359 and a trough of -0.0357 — a signal reading as
    silence — while the lit rows either side implied ±0.505 correctly. Taking the
    topmost and bottommost runs instead recovers the envelope the tool is for.

    `top` is the centroid of each column's **first** lit run and `bottom` of its
    **last**, so the two bracket the trace the way `lit_rows` does, with the beam's
    own width divided out rather than left in.
    """
    lead = np.asarray(img.convert("RGB"), dtype=np.float64)[:, :, channel]
    weight = np.clip(lead - BG8[channel], 0.0, None)
    lit = lead > threshold

    height = lit.shape[0]
    rows = np.arange(height, dtype=np.float64)

    top = np.full(lit.shape[1], np.nan)
    bottom = np.full(lit.shape[1], np.nan)

    for x in range(lit.shape[1]):
        column = lit[:, x]
        if not column.any():
            continue

        # Run boundaries. Padding with a dark row at each end is what makes this
        # correct without special cases: every run then has both a rising and a
        # falling edge, including one that touches the top or bottom of the image,
        # and `flatnonzero` returns integer indices so the slices below are valid.
        padded = np.concatenate(([False], column, [False]))
        step = np.diff(padded.astype(np.int8))
        starts = np.flatnonzero(step == 1)
        ends = np.flatnonzero(step == -1)

        w = weight[:, x]
        for slot, (lo, hi) in ((top, (starts[0], ends[0])), (bottom, (starts[-1], ends[-1]))):
            span = w[lo:hi]
            mass = span.sum()
            if mass > 0:
                slot[x] = float((span * rows[lo:hi]).sum() / mass)

    return top, bottom


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("image")
    ap.add_argument(
        "--palette",
        type=int,
        default=0,
        choices=range(len(TINTS)),
        help="which gradient the shader's palette_row selects: 0 green, 1 amber, 2 blue, 3 neutral",
    )
    ap.add_argument(
        "--threshold",
        type=int,
        default=None,
        help=(
            "level of the palette's dominant channel counted as lit; "
            f"default is derived from an energy of {LIT_ENERGY} deposits"
        ),
    )
    ap.add_argument(
        "--refresh",
        type=float,
        default=DEFAULT_REFRESH_HZ,
        help=(
            "refresh rate the capture was taken at, which sets the white point; "
            f"default {DEFAULT_REFRESH_HZ:g} Hz"
        ),
    )
    ap.add_argument(
        "--scale",
        type=float,
        default=DEFAULT_SCALE,
        help=(
            "backing scale of the display the capture came from, which sets how "
            f"many rows deep the beam is; default {DEFAULT_SCALE:g}"
        ),
    )
    ap.add_argument("--periods", action="store_true", help="also count periods")
    ap.add_argument(
        "--no-crop", action="store_true", help="the image is already exactly the drawable"
    )
    ap.add_argument(
        "--measure-anyway",
        action="store_true",
        help="measure a capture that failed the colour check",
    )
    ap.add_argument(
        "--explain",
        action="store_true",
        help="report the deviation distribution the colour check's constants come from",
    )
    args = ap.parse_args()

    img = open_image(args.image)

    # Before the crop and before any measurement, because everything below reads
    # colours and none of them are the shader's until this has run.
    img, profile = to_srgb(img)
    if profile is None:
        print("no colour profile in the capture; measuring it as sRGB")
    else:
        print(f"converted from {profile} to sRGB")

    if not args.no_crop:
        rgb = np.asarray(img.convert("RGB"), dtype=np.int16)
        box = find_drawable(rgb)
        if box is None:
            # Two explanations, and the second is not obvious. A capture that has
            # been recompressed hard enough loses the exact background before the
            # colour guard below ever runs, so this message has to carry that
            # possibility or it misdiagnoses the case it sees most often.
            # Measured against synthetic captures: a JPEG at quality 60 still
            # crops and is refused by the guard, while quality 40 fails here.
            print("no Fosforo background found in this image.")
            print("Either it is not a capture of the editor, or it has been recompressed")
            print("hard enough to destroy the exact RGB(5, 5, 8) the crop looks for.")
            print("Recapture with:  screencapture -o -x -t png -W shot.png")
            return 1
        if box != (0, 0, img.size[0], img.size[1]):
            print(f"drawable found at x={box[0]} y={box[1]}, cropping to it")
        img = img.crop(box)

    width, height = img.size

    tint = TINTS[args.palette]
    lead = dominant(tint)
    white = white_point(args.refresh)
    threshold = args.threshold if args.threshold is not None else lit_threshold(tint, white)

    # Refusing is right when the picture cannot have come from this shader: a
    # plausible wrong answer is worse than none, and the case that produced this
    # guard reported a railed trace for a signal at full scale.
    drawable = np.asarray(img.convert("RGB"), dtype=np.int16)
    shades = len(np.unique(drawable[:, :, lead]))
    deviation, examined = ray_deviation(drawable, tint)
    fraction = off_ray(deviation, examined)

    # No unsaturated pixel means no usable estimate of the beam's scalar anywhere,
    # so the ray has nothing to say and the guard below would say it anyway. Its
    # own refusal is unconditional rather than overridable, unlike the colour one:
    # `--measure-anyway` trades accuracy for a number, and here there is no number
    # to trade for. Every row below would read zero.
    #
    # Reachable only with `--no-crop`, since `find_drawable` wants a thousand
    # background pixels and an all-saturated image has none, so the message names
    # that rather than a codec.
    if fraction is None:
        print("every pixel in the measured region is saturated, so there is no")
        print("unsaturated pixel to check the beam's colour against.")
        print("This is not a recompressed capture; it is the wrong region. Drop")
        print("--no-crop and let the background find the drawable, or recapture:")
        print("  screencapture -o -x -t png -W shot.png")
        if args.explain:
            explain_ray(deviation, examined)
        return 1

    if fraction > MAX_OFF_RAY and not args.measure_anyway:
        named = ("green", "amber", "storage-tube blue", "neutral")[args.palette]
        print(f"{fraction:.1%} of the drawable's unsaturated pixels are colours this shader")
        print("cannot produce.")
        print(f"It looks every colour up in one {named} gradient, so the other two channels")
        print("follow the brightest one exactly.")
        print("A resampled or recompressed capture breaks that and moves every number below.")
        print("Recapture with:  screencapture -o -x -t png -W shot.png")
        print("  -o drops the window shadow, which otherwise confuses the crop")
        print("  -t png forces lossless, whatever the screenshot default is")
        print("Pass --measure-anyway to measure it regardless, knowing the peak will read high.")
        # Printed on the refusing path too, and this is the path where it is
        # most wanted: a capture that was refused is exactly the one whose
        # deviation distribution decides whether the constants or the capture is
        # at fault.
        if args.explain:
            explain_ray(deviation, examined)
        return 1

    top, bottom, any_lit = lit_rows(img, threshold, lead)

    if not any_lit.any():
        print("no lit pixels found: wrong region, or the capture is of a covered window")
        return 1

    peak_top = int(top[any_lit].min())
    peak_bottom = int(bottom[any_lit].max())
    # The rail's two rows, as row *indices*, so they are comparable with the
    # centroids below and with `measure.railRow` on the Zig side.
    #
    # **The `- 0.5` is the pixel-centre term, and it was missing here until a
    # level-2.000 capture made it visible.** A row index stands for the point
    # `row + 0.5` in window space, which is the same correction `implied_sample`
    # carries; without it these printed 10.8 / 1069.2 at 1080 rows where
    # `src/gpu/measure.zig` computes 10.3 / 1068.7. Half a pixel was invisible
    # while the trace was one pixel wide and both numbers were read off a lit
    # edge. It stopped being invisible when the centroid arrived: the measured
    # trough sits on 1068.68, which is the corrected value and not the old one.
    #
    # The bottom is derived from the same expression rather than as
    # `height - rail_row`, which would put the correction on the wrong side and
    # give 1069.7.
    rail_inset = (1.0 - RAIL) * height / 2
    rail_row = rail_inset - 0.5
    rail_row_bottom = height - rail_inset - 0.5

    print(f"image            {width} x {height}")
    print(f"columns lit      {int(any_lit.sum())} of {width}")
    print(f"centre row       {height / 2:.1f}")
    print(f"rail rows        {rail_row:.1f} / {rail_row_bottom:.1f}")
    # Kept visible rather than dropped with the guard it used to gate. It is the
    # number every pre-#55 measurement was taken under, so anyone holding #38's
    # tables can see at a glance which regime a capture is in, and it is the tell
    # for whether a trail is lit at all.
    #
    # **It no longer distinguishes a trail from its absence and is kept anyway.**
    # Before #60 the picture held two levels of one colour; now a gradient puts
    # dozens of levels in a single frame whether or not anything is fading. The
    # trail message below therefore reads the *rows* instead. Two numbers that used
    # to be one.
    named = ("green", "amber", "storage-tube blue", "neutral")[args.palette]
    print(f"palette          {named}, reading channel {'rgb'[lead]} above {threshold}")
    print(f"{'rgb'[lead]} levels        {shades}")
    print(f"off the curve    {fraction:.2%} of {examined} unsaturated pixels")
    print()
    # The centroid, not the lit edge. See `centroid_rows`; the short version is
    # that a beam has width and its edge is that width away from its centre.
    centre_top, centre_bottom = centroid_rows(img, lead, threshold)
    peak_centre = float(np.nanmin(centre_top))
    trough_centre = float(np.nanmax(centre_bottom))

    print(
        f"highest peak     row {peak_centre:<6.2f} implies sample {implied_sample(peak_centre, height):+.4f}"
    )
    print(
        f"lowest trough    row {trough_centre:<6.2f} implies sample {implied_sample(trough_centre, height):+.4f}"
    )
    # The lit extremes as well, because the gap between the two is the beam's own
    # half-width and seeing it is how you tell a wide beam from a lit trail.
    print(f"lit rows         {peak_top} to {peak_bottom}, against the centroids above")

    # A peak sitting on the rail means "at or above" and nothing more precise.
    #
    # **Measured from the centroid, which is what lets the window stay tight.**
    # Against the lit edge this needed 1.5 rows of slack and still moved with the
    # beam's width; a centroid sits on the rail row itself whatever the width is.
    if abs(peak_centre - rail_row) <= 1.0:
        print("                 ^ on the rail: at or above +0.74 dBFS, amount unknowable")

    plateau = int((top == peak_top).sum())
    print(f"plateau width    {plateau} columns at the highest row")

    # What the brightest pixel implies about the energy behind it, which is the
    # number retuning the curve is done against. `inf` where the tonemap has
    # saturated, which is the brightness axis's own rail: at or above the white
    # point the curve has stopped distinguishing and the honest answer is that the
    # amount is unknowable, exactly as it is for a trace sitting on `RAIL`.
    peak_lead = int(np.asarray(img.convert("RGB"), dtype=np.int16)[:, :, lead].max())
    peak_t = float(tonemapped_from_dominant(tint, peak_lead))
    peak_energy = energy_from_tonemapped(peak_t, white)
    if np.isfinite(peak_energy):
        print(
            f"brightest pixel  {'rgb'[lead]}={peak_lead}, t={peak_t:.4f}, {peak_energy:.2f} deposits"
        )
    else:
        print(f"brightest pixel  {'rgb'[lead]}={peak_lead}, at or above the white point")

    # Persistence changes what a peak row means, and nothing about the picture
    # says so. A column whose lit span is deeper than a couple of pixels is showing
    # a fade rather than this frame's sample, and the topmost lit pixel then
    # belongs to whichever recent frame put the beam highest. The measurement is
    # unchanged and its meaning is not, which is a fact about #55 rather than a
    # defect here (#64).
    #
    # Read off the rows since #60, because the level count this used to test can no
    # longer tell a trail from a gradient.
    # **The floor is the beam's own depth since #57, not a constant.** A beam three
    # points wide spans several rows in every column whether or not anything is
    # fading, so the old fixed `> 2.0` would print this on every capture and the
    # message would stop carrying information. What is compared against is the
    # beam's width at this capture's scale, plus a row of slack for the profile's
    # skirt and the sub-pixel phase.
    beam_rows = BEAM_WIDTH_POINTS * args.scale

    spans = bottom[any_lit] - top[any_lit]
    if spans.size and float(np.median(spans)) > beam_rows + 1.0:
        print()
        print("a trail is lit, so the lit rows above are the envelope over the")
        print("persistence window rather than this frame's beam")

    if args.periods:
        # One run per period, thresholded well above centre so a steep crossing
        # cannot be mistaken for a peak.
        band = (height / 2 + peak_top) / 2
        runs, inside = 0, False
        for x in range(width):
            up = any_lit[x] and top[x] < band
            if up and not inside:
                runs += 1
            inside = up
        print(f"periods          {runs}")

    if args.explain:
        explain_ray(deviation, examined)

    return 0


if __name__ == "__main__":
    sys.exit(main())
