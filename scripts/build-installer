#!/usr/bin/env bash
# build-installer — package both bundles into a signed installer pkg
# Author: Christopher Boone
# Date: 2026-07-30
#
# The second of the three release steps (ADR 0014). Takes the bundles
# scripts/build-release-bundles produced and turns them into one pkg that places
# each in the directory its format is scanned from.
#
# Two certificates are involved and they are not interchangeable. The bundles inside
# are signed with Developer ID *Application*, which build-release-bundles did. The
# package itself is signed with Developer ID *Installer*, which this does. Note that
# `security find-identity -v -p codesigning` does not list installer certificates at
# all, so a null result there is not evidence that one is missing: check with
# `security find-identity -v` and no policy argument.
#
# Usage:
#   FOSFORO_INSTALLER_IDENTITY="Developer ID Installer: ..." build-installer
#   build-installer --unsigned
#
#   --unsigned   Package without signing. For exercising payload paths and domain
#                handling without a certificate. Notarization rejects the result,
#                and the output is named so it cannot be mistaken for a release.
#
# Environment:
#   FOSFORO_INSTALLER_IDENTITY   Required unless --unsigned. The Developer ID
#                                Installer identity.
#
# Exit codes:
#   0  - The package was built
#  64  - Invalid arguments, or FOSFORO_INSTALLER_IDENTITY is unset
#  65  - The version disagrees across its sources, or the payload is misplaced
#  66  - An input bundle is missing
#  70  - pkgbuild or productbuild failed

set -euo pipefail

if [[ -n "${TRACE:-}" ]]; then
  set -x
fi

readonly E_USAGE=64
readonly E_DATAERR=65
readonly E_NOINPUT=66
readonly E_SOFTWARE=70

readonly PROGRAM_NAME="${0##*/}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(dirname -- "${SCRIPT_DIR}")"
readonly REPO_ROOT

readonly CLAP_BUNDLE="zig-out/Fosforo.clap"
readonly AUV2_BUNDLE="build/assets/Fosforo.component"

# Where each format is scanned from. Written absolute; the installer rewrites them
# relative to the user's home if they choose that domain, which is what
# enable_currentUserHome in packaging/distribution.xml buys.
readonly CLAP_INSTALL_LOCATION="/Library/Audio/Plug-Ins/CLAP"
readonly AUV2_INSTALL_LOCATION="/Library/Audio/Plug-Ins/Components"

readonly CLAP_PACKAGE_ID="com.cboone.fosforo.clap"
readonly AUV2_PACKAGE_ID="com.cboone.fosforo.component"

readonly DIST_DIR="dist"
readonly STAGING_DIR="dist/staging"

# Write a message to stderr, prefixed with the program name.
# Arguments:
#   $@ - message parts
function warn() {
  echo "${PROGRAM_NAME}: ${*}" >&2
}

# Announce a step.
# Arguments:
#   $@ - message parts
function step() {
  echo "==> ${*}"
}

function usage() {
  echo "Usage: ${PROGRAM_NAME} [--unsigned]" >&2
}

# Read the version from build.zig.zon, the single source of truth.
# Outputs:
#   The version on stdout
function version_from_zon() {
  sed -n 's/^[[:space:]]*\.version = "\([^"]*\)".*/\1/p' build.zig.zon
}

# Assert that every place the version is written agrees.
#
# The version is not derivable from one source: it crosses Zig and a plist, the same
# way the display name crosses Zig, CMake and a generated plist. This refuses to
# package a disagreement rather than shipping a bundle whose plist contradicts the
# package that installs it.
# Outputs:
#   The agreed version on stdout, diagnostics on stderr
# Returns:
#   0 when all three agree, non-zero otherwise
function resolve_version() {
  local zon short bundle

  zon=$(version_from_zon)
  if [[ -z "${zon}" ]]; then
    warn "could not read .version from build.zig.zon"
    return 1
  fi

  short=$(plutil -extract CFBundleShortVersionString raw -o - -- macos/Info.plist)
  bundle=$(plutil -extract CFBundleVersion raw -o - -- macos/Info.plist)

  # Stated positively, so the condition is "all three agree" rather than a
  # disjunction of ways to disagree. The two are equivalent and this one reads.
  if [[ "${zon}" == "${short}" && "${zon}" == "${bundle}" ]]; then
    echo "${zon}"
    return 0
  fi

  warn "version disagreement, refusing to package:"
  warn "  build.zig.zon .version                      = ${zon}"
  warn "  macos/Info.plist CFBundleShortVersionString = ${short}"
  warn "  macos/Info.plist CFBundleVersion            = ${bundle}"
  return 1
}

# Build one component package from one bundle.
# Arguments:
#   $1 - path to the bundle
#   $2 - package identifier
#   $3 - install location
#   $4 - version
#   $5 - output package path
function build_component() {
  local bundle="${1}" identifier="${2}" location="${3}" version="${4}" output="${5}"

  pkgbuild \
    --component "${bundle}" \
    --identifier "${identifier}" \
    --install-location "${location}" \
    --version "${version}" \
    "${output}"
}

# Assert that the built package lays its payload down where it is supposed to.
#
# A distribution edit can reroute a payload silently: the package still builds, still
# installs, and the plugin simply never appears in any host. Expanding the package and
# reading the paths back is the only check that catches it before a user does.
# Arguments:
#   $1 - path to the built package
# Returns:
#   0 when both bundles appear at their expected locations, non-zero otherwise
function assert_payload_paths() {
  local package="${1}"
  local expanded
  local -i violations=0

  expanded=$(mktemp -d)
  # shellcheck disable=SC2064  # expand now: the path must survive this function.
  trap "rm -rf '${expanded}'" RETURN

  pkgutil --expand "${package}" "${expanded}/pkg"

  local -a expected=(
    "fosforo-clap.pkg:${CLAP_INSTALL_LOCATION}"
    "fosforo-auv2.pkg:${AUV2_INSTALL_LOCATION}"
  )
  local entry component location actual

  for entry in "${expected[@]}"; do
    component="${entry%%:*}"
    location="${entry#*:}"

    if [[ ! -d "${expanded}/pkg/${component}" ]]; then
      warn "${package}: component ${component} is missing"
      ((violations++)) || true
      continue
    fi

    actual=$(sed -n 's/.*install-location="\([^"]*\)".*/\1/p' "${expanded}/pkg/${component}/PackageInfo")
    if [[ "${actual}" != "${location}" ]]; then
      warn "${package}: ${component} installs to '${actual}', expected '${location}'"
      ((violations++)) || true
    fi
  done

  ((violations == 0))
}

function main() {
  local signed=true
  local identity=""
  local version output
  local -a sign_args=()

  while [[ ${#} -gt 0 ]]; do
    case "${1}" in
      --unsigned)
        signed=false
        ;;
      -*)
        warn "unknown option '${1}'"
        usage
        return "${E_USAGE}"
        ;;
      *)
        warn "unexpected argument '${1}'"
        usage
        return "${E_USAGE}"
        ;;
    esac
    shift
  done

  cd -- "${REPO_ROOT}"

  if [[ "${signed}" == true ]]; then
    identity="${FOSFORO_INSTALLER_IDENTITY:-}"
    if [[ -z "${identity}" ]]; then
      warn "FOSFORO_INSTALLER_IDENTITY is unset"
      warn "this needs a Developer ID *Installer* certificate, not the Application one"
      warn "list candidates with: security find-identity -v"
      warn "to exercise packaging without one, pass --unsigned"
      return "${E_USAGE}"
    fi
    sign_args=(--sign "${identity}")
  else
    warn "building UNSIGNED: this cannot be notarized and must not be released"
  fi

  local bundle
  for bundle in "${CLAP_BUNDLE}" "${AUV2_BUNDLE}"; do
    if [[ ! -d "${bundle}" ]]; then
      warn "missing ${bundle}; run scripts/build-release-bundles first"
      return "${E_NOINPUT}"
    fi
  done

  # Assert the inputs rather than trusting them, because the failure this catches is
  # silent and was observed rather than imagined: anything that runs a plain
  # `zig build` between the release build and this step replaces
  # zig-out/Fosforo.clap with a Debug, ad-hoc bundle, and pkgbuild will package it
  # without complaint. Existence is not evidence of provenance. A CMake build used to
  # be one way this happened without anyone asking, and is not any more (#43); a
  # second terminal, an editor's build-on-save, or a `zig build install-clap` in
  # another worktree still are.
  if [[ "${signed}" == true ]]; then
    step "Asserting the bundles about to be packaged will notarize"
    if ! "${SCRIPT_DIR}/assert-distributable-signature" "${CLAP_BUNDLE}" "${AUV2_BUNDLE}"; then
      warn "refusing to package; re-run scripts/build-release-bundles"
      return "${E_DATAERR}"
    fi
  else
    warn "skipping the bundle signature assertion, because --unsigned was passed"
    warn "the packaged bundles may be stale, ad-hoc, or Debug builds"
  fi

  step "Resolving the version"
  if ! version=$(resolve_version); then
    return "${E_DATAERR}"
  fi
  echo "    version ${version}"

  rm -rf "${DIST_DIR}"
  mkdir -p "${STAGING_DIR}"

  step "Building component packages"
  if ! build_component "${CLAP_BUNDLE}" "${CLAP_PACKAGE_ID}" \
    "${CLAP_INSTALL_LOCATION}" "${version}" "${STAGING_DIR}/fosforo-clap.pkg"; then
    return "${E_SOFTWARE}"
  fi
  if ! build_component "${AUV2_BUNDLE}" "${AUV2_PACKAGE_ID}" \
    "${AUV2_INSTALL_LOCATION}" "${version}" "${STAGING_DIR}/fosforo-auv2.pkg"; then
    return "${E_SOFTWARE}"
  fi

  step "Substituting the version into the distribution"
  sed "s/@FOSFORO_VERSION@/${version}/g" \
    packaging/distribution.xml > "${STAGING_DIR}/distribution.xml"

  if [[ "${signed}" == true ]]; then
    output="${DIST_DIR}/Fosforo-${version}.pkg"
  else
    output="${DIST_DIR}/Fosforo-${version}-unsigned.pkg"
  fi

  step "Building ${output}"
  if ! productbuild \
    --distribution "${STAGING_DIR}/distribution.xml" \
    --package-path "${STAGING_DIR}" \
    "${sign_args[@]+"${sign_args[@]}"}" \
    "${output}"; then
    return "${E_SOFTWARE}"
  fi

  step "Asserting the payload lands where hosts look for it"
  if ! assert_payload_paths "${output}"; then
    return "${E_DATAERR}"
  fi

  step "Built ${output}"
}

main "${@}"
